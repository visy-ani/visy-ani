<defs>
<linearGradient id="gGold" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F0D79A"></stop><stop offset=".5" stop-color="#D5AE62"></stop><stop offset="1" stop-color="#8C6A2C"></stop></linearGradient>
<linearGradient id="gGoldFade" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#D5AE62"></stop><stop offset=".55" stop-color="#D5AE62" stop-opacity=".45"></stop><stop offset="1" stop-color="#B6F36A" stop-opacity="0"></stop></linearGradient>
<linearGradient id="gBif" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#B6F36A" stop-opacity="0"></stop><stop offset=".2" stop-color="#B6F36A"></stop><stop offset=".8" stop-color="#D5AE62"></stop><stop offset="1" stop-color="#D5AE62" stop-opacity="0"></stop></linearGradient>
